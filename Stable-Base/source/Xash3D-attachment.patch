@@ -2321,6 +2321,12 @@ R_StudioSetRemapColors
 */
 static void R_StudioSetRemapColors( int newTop, int newBottom )
 {
+	// Client-created MSR equipment deliberately uses entity number -1.  It has
+	// no persistent remap slot, so do not pass that sentinel to the engine's
+	// remap array.
+	if( !RI.currententity || RI.currententity->curstate.number < 0 )
+		return;
+
 	if( gEngfuncs.CL_EntitySetRemapColors( RI.currententity, RI.currentmodel, newTop, newBottom ))
 		m_fDoRemap = true;
 }
