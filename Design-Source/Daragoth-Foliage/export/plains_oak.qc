// Original generated Daragoth foliage. +Z up, ground origin Z=0.
$modelname "plains_oak.mdl"
$cd "."
$cdtexture "."
$scale 1
$gamma 1.8
$origin 0 0 0 -90
$body "prop" "plains_oak_reference"
$sequence "idle" "plains_oak_idle" fps 12 loop
