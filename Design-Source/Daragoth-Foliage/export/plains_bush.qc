// Original generated Daragoth foliage. +Z up, ground origin Z=0.
$modelname "plains_bush.mdl"
$cd "."
$cdtexture "."
$scale 1
$gamma 1.8
$origin 0 0 0 -90
$body "prop" "plains_bush_reference"
$sequence "idle" "plains_bush_idle" fps 12 loop
$bbox -47.0902 -55.7261 0.0000 52.3697 50.2635 64.0000
$cbox -47.0902 -55.7261 0.0000 52.3697 50.2635 64.0000
$texrendermode "bush_leaves.bmp" masked
